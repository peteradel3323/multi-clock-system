##Data Import Section

read_file -type verilog ALU_16_bit.v
read_file -type verilog clk_div.v
read_file -type verilog clk_gating.v
read_file -type verilog data_sampling.v
read_file -type verilog data_syn.v
read_file -type verilog deserializer.v
read_file -type verilog DF_Sync.v
read_file -type verilog edge_bit_counter.v
read_file -type verilog fifo_mem.v
read_file -type verilog fifo_rd.v
read_file -type verilog FIFO_top.v
read_file -type verilog fifo_wr.v
read_file -type verilog fsm_rx.v
read_file -type verilog fsm_tx.v
read_file -type verilog mux4to1.v
read_file -type verilog parity_block.v
read_file -type verilog parity_check.v
read_file -type verilog prescale.v
read_file -type verilog pulse_gen.v
read_file -type verilog reg_file.v
read_file -type verilog rst_sync.v
